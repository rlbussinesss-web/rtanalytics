# Copy to infra/.env on the server, then fill in.  cp .env.prod.example .env

# --- Your two free subdomains (DuckDNS), both pointing at this machine's IP ---
INGEST_DOMAIN=rta-ingest.duckdns.org
API_DOMAIN=rta-api.duckdns.org

# --- Database (invent a long password; nothing outside this machine uses it) ---
POSTGRES_USER=rtanalytics
POSTGRES_PASSWORD=troque-por-uma-senha-longa-aleatoria
POSTGRES_DB=rtanalytics

# --- Dashboard password (what you type to log in) ---
# Use the password you already have, or generate a new long one.
# This file is committed to the repository, so never put the real value here —
# fill it in only in infra/.env on the server, which git ignores.
DASHBOARD_TOKEN=cole-aqui-a-senha-do-painel

# --- Which dashboard addresses may call the API ---
CORS_ORIGINS=https://rtanalytics.vercel.app,https://rta-radar.vercel.app

# --- Optional ---
# Empty means "only site keys registered by the dashboard are accepted",
# which is what you want: projects register themselves when you create them.
ALLOWED_SITE_IDS=
# Server-to-server key for the confirmed-payment webhook. Empty disables it.
SERVER_INGEST_KEY=
# Traffic spike alerts on Telegram. Both empty = disabled.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DASHBOARD_URL=https://rtanalytics.vercel.app
