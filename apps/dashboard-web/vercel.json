{
  "rewrites": [
    {
      "source": "/((?!assets/|tracker.js|recorder.js|demo.html).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(tracker|recorder).js",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    }
  ]
}
