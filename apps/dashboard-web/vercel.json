{
  "rewrites": [
    { "source": "/((?!assets/|tracker.js).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/tracker.js",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    }
  ]
}
